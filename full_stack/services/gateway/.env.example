# Gateway Service — Local Development Environment Variables
# Copy to .env and fill in real values

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/fleettracker
POSTGRES_USER=intersig
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# JWT (must be >= 64 characters)
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_HOURS=8

# SMTP / Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=noreply@intersig.ma

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_REFILL_SECONDS=30

# Flyway
FLYWAY_LOCATIONS=filesystem:../../../db/migrations
