# PostgreSQL
POSTGRES_USER=intersig
POSTGRES_PASSWORD=change_me

# JWT — must be at least 64 bytes base64-encoded
JWT_SECRET=change-me-to-a-real-64-byte-base64-secret

# JWT token lifetimes (optional, defaults shown)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_HOURS=8

# Mail (required for password-reset OTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change_me

# AI engine (RAG chat). The model is pulled into the ollama volume on first run.
OLLAMA_MODEL=gemma4:e2b
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Host port the frontend (nginx) is published on
FRONTEND_PORT=80

# Swagger UI / OpenAPI for the Spring services (off by default). Set to true to expose.
# SWAGGER_ENABLED=true
