# PostgreSQL
POSTGRES_USER=intersig
POSTGRES_PASSWORD=change_me

# JWT — must be at least 64 bytes base64-encoded
JWT_SECRET=change-me-to-a-real-64-byte-base64-secret

# JWT token lifetimes (optional, defaults shown)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_HOURS=8

# Mail (required for password-reset OTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change_me
